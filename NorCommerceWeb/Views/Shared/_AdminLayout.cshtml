@using NorCommerce.Utility
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NorCommerce Admin</title>
    <script type="importmap"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/v/dt/dt-3.1.2/datatables.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NorCommerceWeb.styles.css" asp-append-version="true" />
    <style>
            body {
                font-family: 'Inter', system-ui, sans-serif;
                background: #F4F6F9;
            }

            /* Fixed-width sidebar that never shrinks */
            .admin-sidebar {
                flex: 0 0 240px;
                width: 240px;
                height: 100vh;
                background: #13294B;
                border-right: 1px solid rgba(255,255,255,0.08);
            }

            /* min-width: 0 lets wide tables scroll instead of pushing the page sideways */
            .admin-main {
                min-width: 0;
            }

            .admin-sidebar-nav .nav-link {
                color: #B4C3D9;
                font-size: 0.875rem;
                padding: 0.5rem 0.75rem;
                border-radius: 0.375rem;
                text-decoration: none;
            }

                .admin-sidebar-nav .nav-link:hover {
                    color: #fff;
                    background: rgba(255,255,255,0.06);
                }

                .admin-sidebar-nav .nav-link.active {
                    color: #fff;
                    background: #C8102E;
                }

            .admin-sidebar-nav .nav-section {
                font-size: 0.65rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                color: #8FA3C0;
                padding: 0.5rem 0.75rem;
                margin-top: 0.75rem;
            }
    </style>
</head>
<body>
    
    <!-- Mobile top bar (below lg) -->
    <div class="d-lg-none sticky-top border-bottom" style="background: #13294B; border-color: rgba(255,255,255,0.08) !important; z-index: 1030;">
        <div class="d-flex align-items-center justify-content-between px-3 py-2">
            <button class="btn btn-link text-white-50 p-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarOffcanvas" aria-controls="sidebarOffcanvas">
                <i class="bi bi-list fs-4"></i>
            </button>
            <span class="fw-semibold text-white">Admin Panel</span>
            <button id="themeToggleMobile" class="btn btn-link text-white-50 p-0" type="button">
                <i class="bi bi-moon-stars"></i>
            </button>
        </div>
    </div>

    <!-- Mobile sidebar (offcanvas) -->
    <div class="offcanvas offcanvas-start" tabindex="-1" id="sidebarOffcanvas" style="background: #13294B; width: 260px;">
        <div class="offcanvas-header border-bottom" style="border-color: rgba(255,255,255,0.08) !important;">
            <h6 class="mb-0 fw-semibold text-white">NorCommerce <small style="color: #FF6B6B;">Admin</small></h6>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body p-3 d-flex flex-column">
            <div class="flex-grow-1">
                <partial name="_AdminSidebarNav" />
            </div>
            <div class="border-top pt-3 mt-3" style="border-color: rgba(255,255,255,0.08) !important;">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-person-circle" style="color: #B4C3D9;"></i>
                    <span class="small text-truncate text-white">@User.Identity?.Name</span>
                </div>
                <div class="d-flex gap-2">
                    <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-light flex-grow-1">
                        <i class="bi bi-shop"></i> Store
                    </a>
                    <form asp-area="Identity" asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Logout">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex min-vh-100">

        <!-- Desktop sidebar (lg and up) -->
        <aside class="admin-sidebar d-none d-lg-flex flex-column position-sticky top-0">
            <div class="p-3 border-bottom" style="border-color: rgba(255,255,255,0.08) !important;">
                <h6 class="mb-0 fw-semibold text-white">NorCommerce <small style="color: #FF6B6B;">Admin</small></h6>
            </div>

            <nav class="flex-grow-1 overflow-auto p-3">
                <partial name="_AdminSidebarNav" />
            </nav>

            <div class="border-top p-3" style="border-color: rgba(255,255,255,0.08) !important;">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-person-circle" style="color: #B4C3D9;"></i>
                    <span class="small text-truncate flex-grow-1 text-white" title="@User.Identity?.Name">@User.Identity?.Name</span>
                    <button id="themeToggle" class="btn btn-sm btn-link p-0" style="color: #B4C3D9;" type="button" title="Toggle theme">
                        <i class="bi bi-moon-stars" id="themeIcon"></i>
                    </button>
                </div>
                <div class="d-flex gap-2">
                    <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-light flex-grow-1">
                        <i class="bi bi-shop"></i> Store
                    </a>
                    <form asp-area="Identity" asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Logout">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <!-- Main column: content + footer -->
        <div class="admin-main flex-grow-1 d-flex flex-column">
            <main class="flex-grow-1">
                <div class="p-3 p-lg-4">
                    <partial name="_Notification" />
                    @RenderBody()
                </div>
            </main>

            <footer class="py-3" style="background: #0C1C33;">
                <div class="container-fluid px-3 px-lg-4">
                    <div class="d-flex flex-column flex-sm-row align-items-center justify-content-between gap-2">
                        <p class="mb-0 text-white-50 small">&copy; @DateTime.Now.Year NorCommerce. All rights reserved.</p>
                        <p class="mb-0 text-white-50" style="font-size: 0.75rem;">Made with <i class="bi bi-heart mx-1" style="color: #FF6B6B;"></i> by aashish</p>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.datatables.net/v/dt/dt-3.1.2/datatables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
