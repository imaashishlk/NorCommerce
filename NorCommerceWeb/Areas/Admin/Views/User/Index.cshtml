@model List<NorCommerce.Models.OrderHeader>
@using NorCommerce.Utility
@using NorCommerce.Models

<div class="container-fluid">
    <div class="card border shadow-sm overflow-hidden">
        <div class="card-header text-white py-3 px-4 d-flex align-items-center justify-content-between" style="background: linear-gradient(to right, #1F4E8C, #13294B, #0C1C33);">
            <div>
                <h5 class="mb-0 fw-bold"><i class="bi bi-people me-2"></i>Users</h5>
                <p class="mb-0 small" style="color: #A9C1E3;">Manage user accounts and roles</p>
            </div>
            @* TODO: Add link to user registration page *@
            <a href="#" class="btn btn-sm btn-outline-light fw-semibold d-inline-flex align-items-center gap-1">
                <i class="bi bi-person-plus"></i> Create User
            </a>
        </div>
        <div class="card-body" style="min-height: 500px;">
            <table id="tblData" class="table" style="width:100%">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Role</th>
                        <th></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@* TODO: Add JavaScript file for user management functionality *@


@section Scripts {
    <script src="~/js/userIndex.js" asp-append-version="true"></script>
}
