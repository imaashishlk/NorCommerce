@using NorCommerce.Models
@using NorCommerce.Utility
@model OrderHeader

@{
    var readOnlyProp = "readonly";
    Layout = "_Layout";

    var container = "container-fluid py-4";

    if (User.IsInRole(StaticDetails.RoleAdmin) || User.IsInRole(StaticDetails.RoleEmployee))
    {
        readOnlyProp = null;
        Layout = "_AdminLayout";
        container = "container-fluid py-4";
    }
    else
    {
        Layout = "_Layout";
        container = "container py-4";
    }
}



<div class="@container">
    <form method="post">
        <input asp-for="@Model.Id" hidden />
        @* TODO: Add hidden input for order ID *@

        @* TODO: Add back to orders link *@
        <a asp-area="Admin" asp-controller="Order" asp-action="Index" class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 mb-3">
            <i class="bi bi-arrow-left"></i> Back to orders
        </a>

        <div class="card border shadow-sm overflow-hidden">
            <div class="card-header text-white py-3 px-4" style="background: linear-gradient(to right, #1F4E8C, #13294B, #0C1C33);">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-receipt me-2"></i>Order #<span>@Model.Id</span>
                </h5>
                <p class="mb-0 small" style="color: #A9C1E3;">Placed on <span>@Model.OrderDate.ToString("MM/dd/yyyy")</span></p>
            </div>

            <div class="card-body p-4">
                <div class="row g-5">
                    <!-- Left column: Shipping info -->
                    <div class="col-lg-6">
                        <h6 class="text-uppercase fw-semibold text-secondary mb-4" style="font-size: 0.7rem; letter-spacing: 0.1em;">
                            Shipping &amp; Tracking
                        </h6>

                        <div class="row g-2 mb-2">
                            <label class="col-4 col-form-label small fw-medium text-secondary">Name</label>
                            <div class="col-8">
                                @* TODO: Bind to Name property, make editable for admin, readonly for customer *@
                                <input type="text" class="form-control form-control-sm" asp-for="Name" value="@Model.Name" readonly="@(readOnlyProp)" />
                                <span class="text-danger small" asp-validation-for="Name"></span>
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <label class="col-4 col-form-label small fw-medium text-secondary">Phone</label>
                            <div class="col-8">
                                @* TODO: Bind to Phone property *@
                                <input type="text" class="form-control form-control-sm" asp-for="PhoneNumber" value="@Model.PhoneNumber" readonly="@(readOnlyProp)" />
                                <span class="text-danger small" asp-validation-for="PhoneNumber"></span>
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <label class="col-4 col-form-label small fw-medium text-secondary">Address</label>
                            <div class="col-8">
                                @* TODO: Bind to Address property *@
                                <input type="text" class="form-control form-control-sm" asp-for="StreetAddress" value="@Model.StreetAddress" readonly="@(readOnlyProp)" />
                                <span class="text-danger small" asp-validation-for="StreetAddress"></span>
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <label class="col-4 col-form-label small fw-medium text-secondary">City</label>
                            <div class="col-8">
                                @* TODO: Bind to City property *@
                                <input type="text" class="form-control form-control-sm" asp-for="City" value="@Model.City" readonly="@(readOnlyProp)" />
                                <span class="text-danger small" asp-validation-for="City"></span>
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <label class="col-4 col-form-label small fw-medium text-secondary">State</label>
                            <div class="col-8">
                                @* TODO: Bind to State property *@
                                <input type="text" class="form-control form-control-sm" asp-for="State" value="@Model.State" readonly="@(readOnlyProp)" />
                                <span class="text-danger small" asp-validation-for="State"></span>
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <label class="col-4 col-form-label small fw-medium text-secondary">Zip Code</label>
                            <div class="col-8">
                                @* TODO: Bind to PostalCode property *@
                                <input type="text" class="form-control form-control-sm" asp-for="PostalCode" value="@Model.PostalCode" readonly="@(readOnlyProp)" />
                                <span class="text-danger small" asp-validation-for="PostalCode"></span>
                            </div>
                        </div>

                        <div class="row g-2 mb-2">
                            <label class="col-4 col-form-label small fw-medium text-secondary">Email</label>
                            <div class="col-8">
                                @* TODO: Display user email (read-only) *@
                                <input type="email" readonly class="form-control-plaintext form-control-sm" asp-for="ApplicationUser.Email" />
                            </div>
                        </div>

                        @if (Model.OrderDate != default)
                        {
                            <div class="row g-2 mb-2">
                                <label class="col-4 col-form-label small fw-medium text-secondary">Order Date</label>
                                <div class="col-8">
                                    @* TODO: Display order date (read-only) *@
                                    <input type="text" readonly class="form-control-plaintext form-control-sm" asp-for="OrderDate" value="@Model.OrderDate.ToString("MM/dd/yyyy")" />
                                </div>
                            </div>
                        }

                        @if (Model.OrderStatus != StaticDetails.StatusPending && Model.OrderStatus != StaticDetails.StatusApproved)
                        {
                            <div class="row g-2 mb-2">
                                <label class="col-4 col-form-label small fw-medium text-secondary">Carrier</label>
                                <div class="col-8">
                                    @* TODO: Bind to Carrier property *@
                                    <input type="text" id="carrier" class="form-control form-control-sm" asp-for="Carrier" value="@Model.Carrier" readonly="@(readOnlyProp)" />
                                    <span class="text-danger small" asp-validation-for="Carrier"></span>

                                </div>
                            </div>

                            <div class="row g-2 mb-2">
                                <label class="col-4 col-form-label small fw-medium text-secondary">Tracking</label>
                                <div class="col-8">
                                    @* TODO: Bind to TrackingNumber property *@
                                    <input type="text" id="trackingNumber" class="form-control form-control-sm" asp-for="TrackingNumber" value="@Model.TrackingNumber" readonly="@(readOnlyProp)" />
                                    <span class="text-danger small" asp-validation-for="TrackingNumber"></span>
                                </div>
                            </div>
                        }

                        @if (Model.OrderStatus == StaticDetails.StatusShipped && Model.ShippingDate != default)
                        {
                            <div class="row g-2 mb-2">
                                <label class="col-4 col-form-label small fw-medium text-secondary">Shipping Date</label>
                                <div class="col-8">
                                    @* TODO: Display shipping date (read-only) *@
                                    <input type="text" readonly class="form-control-plaintext form-control-sm" asp-for="ShippingDate" value="@Model.ShippingDate.ToString("MM/dd/yyyy")" />
                                </div>
                            </div>
                        }

                        @if (User.IsInRole(StaticDetails.RoleAdmin) || User.IsInRole(StaticDetails.RoleEmployee))
                        {
                            @if (Model.OrderStatus == @StaticDetails.StatusShipped)
                            {
                                <button type="submit" disabled asp-action="UpdateOrderDetails" asp-route-id="@Model.Id" class="btn btn-accent w-100 fw-semibold mt-3">
                                    Update Order Details
                                </button>
                            }
                            else
                            {
                                <button type="submit" asp-action="UpdateOrderDetails" asp-route-id="@Model.Id" class="btn btn-accent w-100 fw-semibold mt-3">
                                    Update Order Details
                                </button>
                            }
                        }

                    </div>

                    <!-- Right column: Order summary -->
                    <div class="col-lg-6">
                        <h6 class="text-uppercase fw-semibold text-secondary mb-4" style="font-size: 0.7rem; letter-spacing: 0.1em;">
                            Order Summary
                        </h6>

                        <span class="badge bg-dark mb-3">
                            <i class="bi bi-info-circle me-1"></i> <span>@Model.OrderStatus</span>
                            @* TODO: Display order status *@
                        </span>

                        <div class="border rounded overflow-hidden mb-4">
                            @* TODO: Loop through order items *@

                            <!-- Sample order item -->
                            @foreach (var item in Model.OrderDetails)
                            {
                                <div class="d-flex justify-content-between align-items-start p-3 border-bottom">
                                    <div>
                                        <p class="fw-medium small mb-0">@item.Product.Title</p>
                                        @* TODO: Display product title *@
                                        <p class="text-secondary mb-0" style="font-size: 0.75rem;">
                                            @item.Price.ToString("c") x @item.Count
                                            @* TODO: Display price and quantity *@
                                        </p>
                                    </div>
                                    <p class="fw-semibold small mb-0" style="color: #13294B;">
                                        @((item.Count * item.Price).ToString("c"))
                                        @* TODO: Display line total *@
                                    </p>
                                </div>
                            }

                            <div class="d-flex justify-content-between align-items-center p-3 text-white" style="background: linear-gradient(to right, #1F4E8C, #13294B, #0C1C33);">
                                <span class="fw-bold small text-uppercase">Total</span>
                                <span class="fw-bold fs-5">$199.98</span>
                                @* TODO: Display order total *@
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            @if (User.IsInRole(StaticDetails.RoleAdmin) || User.IsInRole(StaticDetails.RoleEmployee))
                            {
                                @if (Model.OrderStatus != StaticDetails.StatusInProcess && Model.OrderStatus != StaticDetails.StatusShipped)
                                {
                                    <button type="submit" asp-action="UpdateStatus" asp-route-id="@Model.Id" asp-route-status="@StaticDetails.StatusInProcess" class="btn fw-semibold text-white" style="background: #13294B;">
                                        Start Processing
                                    </button>
                                }

                                @if (Model.OrderStatus != StaticDetails.StatusShipped && Model.OrderStatus != StaticDetails.StatusRefunded && Model.OrderStatus != StaticDetails.StatusCancelled)
                                {
                                    <button type="submit" asp-action="UpdateStatus" asp-route-id="@Model.Id" asp-route-status="@StaticDetails.StatusShipped" asp-route-carrier="@Model.Carrier" asp-route-trackingNumber="@Model.TrackingNumber" onclick="return validateInput()" class="btn btn-danger fw-semibold">
                                        Ship Order
                                    </button>
                                }
                            }

                            @if (Model.OrderStatus != StaticDetails.StatusShipped && Model.OrderStatus != StaticDetails.StatusCancelled)
                            {
                                <button type="submit" asp-action="UpdateStatus" asp-route-id="@Model.Id" asp-route-status="@StaticDetails.StatusCancelled" class="btn btn-outline-danger fw-semibold">
                                    Cancel Order
                                </button>
                            }

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
