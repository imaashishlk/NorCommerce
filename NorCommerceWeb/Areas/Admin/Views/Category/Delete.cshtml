@model NorCommerce.Models.Category

@{
    ViewData["Title"] = L["DeleteCategory"].Value;
}

<div class="container-fluid py-4">
    <a asp-controller="Category" asp-action="Index" class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 mb-3">
        <i class="bi bi-arrow-left"></i> @L["BackToCategories"]
    </a>
    <div class="card border shadow-sm overflow-hidden">
        <div class="card-header text-white py-3 px-4" style="background: linear-gradient(to right, #1F4E8C, #13294B, #0C1C33);">
            <h5 class="mb-0 fw-bold"><i class="bi bi-plus-lg me-2"></i>@L["DeleteCategory"]</h5>
            <p class="mb-0 small" style="color: #A9C1E3;" ">@L["DeleteCategorySubtitle"]</p>
        </div>
        <div class="card-body p-4">
            <form method="POST" asp-action="Delete">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                <input asp-for="Id" name="Id" hidden />
                <div class="mb-3">
                    <label class="form-label fw-semibold small" asp-for="Name"></label>
                    <input type="text" name="Name" asp-for="Name" readonly class="form-control" placeholder="@L["EnterCategoryName"]" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small" asp-for="DisplayOrder"></label>
                    <input type="number" name="DisplayOrder" asp-for="DisplayOrder" readonly class="form-control" placeholder="@L["EnterDisplayOrder"]" />
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-danger fw-semibold">@L["DeleteCategory"]</button>
                    <a asp-controller="Category" asp-action="Index" class="btn btn-light fw-medium">@L["Cancel"]</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}