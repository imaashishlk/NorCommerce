@model List<NorCommerce.Models.Category>

@{
    ViewData["Title"] = L["Categories"].Value;
}

<div class="container-fluid py-4">
    <div class="card border shadow-sm overflow-hidden">
        <div class="card-header text-white py-3 px-4 d-flex align-items-center justify-content-between" style="background: linear-gradient(to right, #1F4E8C, #13294B, #0C1C33);">
            <div>
                <h5 class="mb-0 fw-bold"><i class="bi bi-grid me-2"></i>@L["Categories"]</h5>
                <p class="mb-0 small" style="color: #A9C1E3;">@L["CategoriesSubtitle"]</p>
            </div>
            <a asp-controller="Category" asp-action="Create" class="btn btn-sm btn-outline-light fw-semibold d-inline-flex align-items-center gap-1">
                <i class="bi bi-plus-lg"></i> @L["NewCategory"]
            </a>
        </div>
        <div class="table-responsive">
            <table class="table-styled">
                <thead>
                    <tr>
                        <th>@L["CategoryName"]</th>
                        <th>@L["DisplayOrder"]</th>
                        <th class="text-end">@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td class="fw-medium" style="color: #13294B;">@category.Name</td>
                            <td><span class="badge bg-light text-dark border">@category.DisplayOrder</span></td>
                            <td class="text-end">
                                <a asp-action="Update" asp-route-id="@category.Id" class="btn btn-sm btn-outline-dark me-1"><i class="bi bi-pencil-square me-1"></i>@L["Edit"]</a>
                                <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i>@L["Delete"]</a>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>