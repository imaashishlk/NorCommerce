@using NorCommerce.Models.ViewModels;
@model ProductVM

<div class="container-fluid py-4">
    <a asp-controller="Product" asp-action="Index" class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 mb-3">
        <i class="bi bi-arrow-left"></i> @L["BackToProducts"]
    </a>
    <div class="card border shadow-sm overflow-hidden">
        <div class="card-header text-white py-3 px-4" style="background: linear-gradient(to right, #1F4E8C, #13294B, #0C1C33);">
            <h5 class="mb-0 fw-bold"><i class="bi bi-plus-lg me-2"></i>@(Model.Product.Id == 0 ? L["CreateProduct"] : L["UpdateExistingProduct"])</h5>
            <p class="mb-0 small" style="color: #A9C1E3;">@(Model.Product.Id == 0 ? L["AddProduct"] : L["UpdateProduct"])</p>
        </div>
        <div class="card-body p-4">
            <form method="POST" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="row g-0 border rounded overflow-hidden" style="min-height: 75vh;">

                    <!-- Form section -->
                    <div class="col-lg-7 p-4 p-lg-5">

                        <input asp-for="Product.Id" class="form-control" type="hidden" />

                        <div class="mb-3">
                            <label asp-for="Product.Title" class="form-label">@L["Title"]</label>
                            <input asp-for="Product.Title" class="form-control" />
                            <span asp-validation-for="Product.Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@L["Description"]</label>
                            <input type="hidden" asp-for="Product.Description" />
                            <div id="description-quill" style="height: 200px;"></div>
                            <span asp-validation-for="Product.Description" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Product.ISBN" class="form-label">@L["Isbn"]</label>
                                <input asp-for="Product.ISBN" class="form-control" />
                                <span asp-validation-for="Product.ISBN" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Product.Author" class="form-label">@L["Author"]</label>
                                <input asp-for="Product.Author" class="form-control" />
                                <span asp-validation-for="Product.Author" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-6 col-md-3">
                                <label asp-for="Product.ListPrice" class="form-label">@L["ListPrice"]</label>
                                <input asp-for="Product.ListPrice" class="form-control" />
                                <span asp-validation-for="Product.ListPrice" class="text-danger small"></span>
                            </div>
                            <div class="col-6 col-md-3">
                                <label asp-for="Product.Price" class="form-label">@L["Price1To49"]</label>
                                <input asp-for="Product.Price" class="form-control" />
                                <span asp-validation-for="Product.Price" class="text-danger small"></span>
                            </div>
                            <div class="col-6 col-md-3">
                                <label asp-for="Product.Price50" class="form-label">@L["Price50Plus"]</label>
                                <input asp-for="Product.Price50" class="form-control" />
                                <span asp-validation-for="Product.Price50" class="text-danger small"></span>
                            </div>
                            <div class="col-6 col-md-3">
                                <label asp-for="Product.Price100" class="form-label">@L["Price100Plus"]</label>
                                <input asp-for="Product.Price100" class="form-control" />
                                <span asp-validation-for="Product.Price100" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Product.CategoryId" class="form-label">@L["Category"]</label>
                            <select asp-for="Product.CategoryId" asp-items="@Model.CategoryList" class="form-select">
                                <option disabled selected value="">@L["SelectCategory"]</option>
                            </select>
                            <span asp-validation-for="Product.CategoryId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label for="file" class="form-label">@L["ChooseImage"]</label>
                            <input type="file" name="file" id="file" class="form-control" accept="image/*" />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-accent fw-semibold">@(Model.Product.Id == 0 ? L["CreateProduct"] : L["UpdateProduct"])</button>
                            <a asp-controller="Product" asp-action="Index" class="btn btn-light fw-medium">@L["Cancel"]</a>
                        </div>
                    </div>

                    <!-- Image section -->
                    <div class="col-lg-5 bg-light p-4 p-lg-5 d-flex flex-column">
                        <div class="flex-grow-1 d-flex align-items-center justify-content-center border rounded bg-white overflow-hidden"
                             style="min-height: 280px;">
                            <img id="imagePreview" class="img-fluid d-none" alt="@L["ProductImagePreview"]" />
                            <p id="imagePlaceholder" class="text-muted text-center m-0 p-4">
                                @if (!string.IsNullOrEmpty(Model.Product?.ImageUrl))
                                {
                                    <img src="@Model.Product.ImageUrl" class="img-fluid" alt="@L["ProductImage"]" />
                                    <input asp-for="@Model.Product.ImageUrl" class="form-control" type="hidden" />
                                }
                                else
                                {
                                    <i class="bi bi-camera text-muted" style="font-size: 4rem;"></i>
                                }

                            </p>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
    <script>
        const descriptionInput = document.getElementById('Product_Description');

        const quill = new Quill('#description-quill', {
            theme: 'snow'
        });

        if (descriptionInput.value) {
            quill.setContents(quill.clipboard.convert({ html: descriptionInput.value }));
        }

        quill.on('text-change', () => {
            const isEmpty = quill.getText().trim().length === 0;
            descriptionInput.value = isEmpty ? '' : quill.root.innerHTML;
        });
    </script>
}