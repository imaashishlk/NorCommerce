<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border overflow-hidden">
                <div class="card-header text-white py-3 px-4 text-center" style="background: linear-gradient(to right, #1F4E8C, #13294B, #0C1C33);">
                    <i class="bi bi-exclamation-triangle-fill display-4"></i>
                    <h4 class="fw-bold mt-2 mb-1">@L["AccessDenied"]</h4>
                    <p class="mb-0 small" style="color: #A9C1E3;">@L["PermissionRequired"]</p>
                </div>

                <div class="card-body p-5 text-center">
                    <p class="text-secondary mb-4">
                        @L["AccessDeniedText"]
                    </p>
                    <!-- TODO: Add Link -->
                    <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-accent">
                        <i class="bi bi-house me-2"></i>@L["GoToHome"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>