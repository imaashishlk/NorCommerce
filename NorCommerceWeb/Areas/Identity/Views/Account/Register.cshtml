@using NorCommerce.Models.ViewModels;
@model RegisterVM

@{
    ViewData["Title"] = "Register";
}


<div class="container">
    <div class="row justify-content-center mt-5 mb-5">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-sm border overflow-hidden">
                <div class="card-header text-white py-3 px-4 text-center" style="background: linear-gradient(to right, #1F4E8C, #13294B, #0C1C33);">
                    <i class="bi bi-person-plus-fill display-4"></i>
                    <h4 class="fw-bold mt-2 mb-1">Create Account</h4>
                    <p class="mb-0 small" style="color: #A9C1E3;">Join us today</p>
                </div>

                <div class="card-body p-5">
                    <form method="POST" asp-controller="Account" asp-action="Register" asp-route-returnURL="@ViewData["ReturnURL"]">
                        <div class="text-danger mb-3" asp-validation-summary="ModelOnly"></div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <!-- TODO: Add label, input and validation tag helper for Name property -->
                                <label asp-for="Name"></label>
                                <input asp-for="Name" type="text" class="form-control" placeholder="Ola Nordmann" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <!-- TODO: Add label, input and validation tag helper for Email property -->
                                <label asp-for="Email"></label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="ola.nordmann@example.no" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <!-- TODO: Add label, input and validation tag helper for Password property -->
                                <label asp-for="Password"></label>
                                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <!-- TODO: Add label, input and validation tag helper for ConfirmPassword property -->
                                <label asp-for="ConfirmPassword"></label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <!-- TODO: Add label, input and validation tag helper for PhoneNumber property -->
                            <label asp-for="PhoneNumber"></label>
                            <input asp-for="PhoneNumber" type="tel" class="form-control" placeholder="+47 912 34 567" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <!-- TODO: Add label, input and validation tag helper for StreetAddress property -->
                            <label asp-for="StreetAddress"></label>
                            <input asp-for="StreetAddress" type="text" class="form-control" placeholder="Kirkegata 15" />
                            <span asp-validation-for="StreetAddress" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <!-- TODO: Add label, input and validation tag helper for PostalCode property -->
                                <label asp-for="PostalCode"></label>
                                <input asp-for="PostalCode" type="text" class="form-control" placeholder="4006" maxlength="4" inputmode="numeric" />
                                <span asp-validation-for="PostalCode" class="text-danger"></span>
                            </div>

                            <div class="col-md-5 mb-3">
                                <!-- TODO: Add label, input and validation tag helper for City property -->
                                <label asp-for="City"></label>
                                <input asp-for="City" type="text" class="form-control" placeholder="Stavanger" />
                                <span asp-validation-for="City" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <!-- TODO: Add label, input and validation tag helper for State property -->
                                <label asp-for="State"></label>
                                <input asp-for="State" type="text" class="form-control" placeholder="Rogaland" />
                                <span asp-validation-for="State" class="text-danger"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-accent btn-lg w-100 mb-3">
                            <i class="bi bi-person-check me-2"></i>Register
                        </button>
                    </form>

                    <hr class="my-4" />

                    <div class="text-center">
                        <!-- TODO: Add Link -->
                        <p class="mb-0">Already have an account? <a href="#" class="fw-semibold text-decoration-none" style="color: #C8102E;">Log in</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}