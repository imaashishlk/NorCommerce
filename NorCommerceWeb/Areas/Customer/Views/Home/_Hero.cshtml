@using NorCommerce.Models
@model IEnumerable<Product>

@{
    var allBooks = Model.ToList();
    var featured = allBooks.Take(3).ToList();
    var bookCount = allBooks.Count;
    var categoryCount = allBooks.Select(p => p.CategoryId).Distinct().Count();
}

<section class="position-relative overflow-hidden" style="background: #13294B;">
    <div class="position-absolute top-0 end-0 bottom-0 d-none d-lg-block" style="width: 45%; background: linear-gradient(160deg, #2A5FA8, #1F4E8C); clip-path: polygon(15% 0, 100% 0, 100% 100%, 0% 100%);"></div>
    <div class="container position-relative py-5" style="z-index: 2;">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 text-center text-lg-start">
                <p class="text-uppercase small fw-semibold mb-3" style="color: #FF6B6B; letter-spacing: 0.25em; font-size: 0.75rem;">
                    <i class="bi bi-star me-1"></i> @L["HeroTag"], @DateTime.Now.ToString("MMMM yyyy", System.Globalization.CultureInfo.CurrentUICulture)
                </p>
                <h1 class="display-4 fw-bold text-white lh-sm mb-4">
                    @L["HeroTitle1"] <br class="d-none d-sm-block" />
                    @L["HeroTitle2"] <span style="color: #FF6B6B;">@L["HeroTitleHighlight"]</span>
                </h1>
                <p class="lead mb-4" style="color: #B4C3D9; max-width: 500px;">
                    @L["HeroSubtitle"]
                </p>
                <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center justify-content-lg-start mb-5">
                    <a href="#catalog" class="btn btn-lg btn-accent fw-bold rounded-pill px-4">
                        @L["ShopBooks"] <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                    <a href="#catalog" class="btn btn-lg btn-ghost-light rounded-pill px-4">
                        <i class="bi bi-compass me-1"></i> @L["Categories"]
                    </a>
                </div>
                <div class="row g-4 text-center text-lg-start" style="max-width: 420px;">
                    <div class="col-4">
                        <p class="fs-4 fw-bold text-white mb-0">@bookCount</p>
                        <p class="text-uppercase mb-0" style="font-size: 0.65rem; color: #8FA3C0; letter-spacing: 0.1em;">@L["Books"]</p>
                    </div>
                    <div class="col-4 border-start" style="border-color: rgba(255,255,255,0.12) !important;">
                        <p class="fs-4 fw-bold text-white mb-0">@categoryCount</p>
                        <p class="text-uppercase mb-0" style="font-size: 0.65rem; color: #8FA3C0; letter-spacing: 0.1em;">@L["Categories"]</p>
                    </div>
                    <div class="col-4 border-start" style="border-color: rgba(255,255,255,0.12) !important;">
                        <p class="fs-4 fw-bold text-white mb-0"><i class="bi bi-shield-check" style="color: #FF6B6B;"></i></p>
                        <p class="text-uppercase mb-0" style="font-size: 0.65rem; color: #8FA3C0; letter-spacing: 0.1em;">@L["SecurePayment"]</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 d-none d-lg-block" style="z-index: 2;">
                <div class="position-relative d-flex align-items-center justify-content-center" style="height: 400px;">
                    @if (featured.Count > 1)
                    {
                        <!-- Back-left book -->
                        <div class="position-absolute hero-book-side" style="left: 40px; transform: rotate(-8deg) translateY(20px); z-index: 1;">
                            <a asp-action="Details" asp-route-id="@featured[1].Id" class="d-block rounded-3 overflow-hidden shadow" style="width: 160px; height: 230px; opacity: 0.75;">
                                <img src="@featured[1].ImageUrl" alt="@featured[1].Title" class="w-100 h-100" style="object-fit: cover;" />
                            </a>
                        </div>
                    }

                    @if (featured.Count > 0)
                    {
                        <!-- Center featured book -->
                        <div class="position-relative" style="z-index: 3;">
                            <a asp-action="Details" asp-route-id="@featured[0].Id" class="d-block hero-book-main">
                                <div class="rounded-3 overflow-hidden shadow-lg" style="width: 240px; height: 340px;">
                                    <img src="@featured[0].ImageUrl" alt="@featured[0].Title" class="w-100 h-100" style="object-fit: cover;" />
                                </div>
                            </a>
                            <div class="position-absolute top-0 end-0 rounded-3 shadow px-3 py-2" style="transform: translate(20px, -12px); z-index: 10; background: rgba(255,255,255,0.97);">
                                <small class="text-uppercase fw-medium d-block" style="font-size: 0.6rem; color: #5A6A82;">Featured</small>
                                <span class="fw-bold" style="color: #13294B;">@featured[0].Price.ToString("C0")</span>
                            </div>
                        </div>
                    }

                    @if (featured.Count > 2)
                    {
                        <!-- Back-right book -->
                        <div class="position-absolute hero-book-side" style="right: 40px; transform: rotate(8deg) translateY(20px); z-index: 1;">
                            <a asp-action="Details" asp-route-id="@featured[2].Id" class="d-block rounded-3 overflow-hidden shadow" style="width: 160px; height: 230px; opacity: 0.75;">
                                <img src="@featured[2].ImageUrl" alt="@featured[2].Title" class="w-100 h-100" style="object-fit: cover;" />
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="position-absolute bottom-0 start-0 end-0" style="line-height: 0;">
        <svg viewBox="0 0 1440 60" preserveAspectRatio="none" style="width: 100%; height: 40px;">
            <path class="hero-curve-fill" d="M0,60 L0,20 Q360,0 720,30 Q1080,60 1440,10 L1440,60 Z" fill="#F4F6F9"></path>
        </svg>
    </div>
</section>