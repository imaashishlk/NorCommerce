@using NorCommerce.Models
@model IEnumerable<Product>

@{
    var allBooks = Model.ToList();
    var covers = allBooks.Where(p => !string.IsNullOrEmpty(p.ImageUrl)).Take(14).ToList();
    var bookCount = allBooks.Count;
    var categoryCount = allBooks.Select(p => p.CategoryId).Distinct().Count();
    var month = DateTime.Now.ToString("MMMM yyyy", System.Globalization.CultureInfo.CurrentUICulture);
}

<section class="hx">
    <div class="hx-glow"></div>
    <div class="hx-grid"></div>

    <div class="container position-relative text-center hx-content">
        <span class="hx-eyebrow">
            <span class="hx-dot"></span>
            @L["HeroTag"] &middot; @month
        </span>

        <h1 class="hx-title">
            @L["HeroTitle1"] <br class="d-none d-md-block" />
            @L["HeroTitle2"] <span class="hx-highlight">@L["HeroTitleHighlight"]</span>
        </h1>

        <p class="hx-subtitle">@L["HeroSubtitle"]</p>

        <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center mb-4">
            <a href="#catalog" class="btn btn-lg btn-accent btn-glow fw-semibold rounded-pill px-4">
                @L["ShopBooks"] <i class="bi bi-arrow-right ms-2"></i>
            </a>
            <a href="#catalog" class="btn btn-lg btn-ghost-light rounded-pill px-4">
                <i class="bi bi-grid me-2"></i>@L["Categories"]
            </a>
        </div>

        <ul class="hx-facts">
            <li><strong>@bookCount</strong> @L["Books"]</li>
            <li><strong>@categoryCount</strong> @L["Categories"]</li>
            <li><i class="bi bi-truck"></i> @L["FastDelivery"]</li>
            <li><i class="bi bi-shield-check"></i> @L["SecurePayment"]</li>
        </ul>
    </div>

    @if (covers.Count >= 4)
    {
        <div class="hx-marquee">
            <div class="hx-track">
                @for (int round = 0; round < 2; round++)
                {
                    foreach (var book in covers)
                    {
                        <a asp-action="Details" asp-route-productId="@book.Id" class="hx-cover"
                           title="@book.Title" tabindex="@(round == 0 ? 0 : -1)">
                            <img src="@book.ImageUrl" alt="@book.Title" loading="lazy" />
                        </a>
                    }
                }
            </div>
        </div>
    }

    <div class="position-absolute bottom-0 start-0 end-0" style="line-height: 0;">
        <svg viewBox="0 0 1440 60" preserveAspectRatio="none" style="width: 100%; height: 40px;">
            <path class="hero-curve-fill" d="M0,60 L0,20 Q360,0 720,30 Q1080,60 1440,10 L1440,60 Z" fill="#F4F6F9"></path>
        </svg>
    </div>
</section>