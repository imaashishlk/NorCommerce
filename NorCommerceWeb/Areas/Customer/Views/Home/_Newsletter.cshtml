<section class="py-5" style="background: linear-gradient(135deg, #1F4E8C 0%, #0C1C33 100%);">
    <div class="container">
        <div class="row justify-content-center text-center text-white">
            <div class="col-lg-8">
                <i class="bi bi-envelope-heart display-4 mb-3"></i>
                <h3 class="fw-bold mb-3">@L["StayUpdated"]</h3>
                <p class="lead mb-4" style="color: #B4C3D9;">
                    @L["NewsletterText"]
                </p>
                <!-- TODO: Add form method and action attributes -->
                <form class="row g-2 justify-content-center">
                    <div class="col-md-6">
                        <input type="email" name="email" class="form-control form-control-lg"
                               placeholder="@L["YourEmailAddress"]" required />
                    </div>
                    <div class="col-md-auto">
                        <button type="submit" class="btn btn-accent btn-lg px-4">
                            @L["Subscribe"]
                        </button>
                    </div>
                </form>
                <p class="small mt-3 mb-0" style="color: #B4C3D9;">
                    <i class="bi bi-shield-check me-1"></i> @L["WeRespectPrivacy"]
                </p>
            </div>
        </div>
    </div>
</section>